{
  "name": "jiojoin-desktop",
  "productName": "JioJoin Desktop",
  "version": "1.0.0",
  "description": "Make and receive calls on your Jio fixed-line number from your desktop.",
  "license": "GPL-3.0-or-later",
  "author": "JioJoin Desktop contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "demo": "JIOJOIN_DEMO=1 electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "engine:deps": "bash engine/scripts/build-deps.sh",
    "engine:build": "bash engine/scripts/build-engine.sh",
    "engine:smoke": "bun engine/scripts/smoke.ts",
    "icons": "bun scripts/make-icons.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "package": "bun run build && electron-builder --publish never",
    "package:mac": "bun run build && electron-builder --mac --arm64 --publish never",
    "package:linux": "bun run build && electron-builder --linux --x64 --publish never",
    "package:win": "bun run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "default-gateway": "^7.2.2",
    "fast-xml-parser": "^5.12.1",
    "libphonenumber-js": "^1.13.17"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.77.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "desktopName": "jiojoin-desktop.desktop"
}
